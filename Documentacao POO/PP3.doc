# Sintaxe:
from nome_outro_arquivo_sem_extensao import NomeClasse
if __name__ == '__main__':               # main <tab> (tecla de atalho)
   objeto1 = NomeClasse(arg1, arg2, arg3) # Instancia objeto com 3 argumentos
