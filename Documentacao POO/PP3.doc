15- No main, use (teste) os métodos gets para consultar os objetos criados
16- No main, use (teste) os métodos sets para os alterar os objetos criados

17- Crie o método funcional deposito, ele recebe o valor do depósito e atualiza
    o saldo e não retorna nada. Vamos implementar em qual classe? Teste
18- Faça uma validação no método deposito. Msg. de erro, se valor negativo. Teste
19- Crie o método retirada, ele recebe o valor da retirada e atualiza o saldo, teste
20- Refaça o método retirada usando RNs (Regras de Negócio) bancárias. Teste
"""

# O nome de classe começa com letra maiúscula e as outras letras minúsculas.
# class Conta(object): # Três formas equivalentes de criar classe
# class Conta():
class Conta:                       # Superclasse (classe mãe) # 1
    def __init__(self, nome, saldo=0.0): # Construtor com valor default (padrão) # 2
        self.nome = nome           # Atributos de instância
        self.saldo = saldo
    def get_nome(self):            # Consulta               # 3
        return self.nome
    def get_saldo(self):
        return self.saldo
    def set_nome(self, novo_nome): # Altera                 # 4
        self.nome = novo_nome
    # Obs.: não implemente o método set_saldo, RN (Regra de Negócio) dos bancos

    # def deposito(self, valor):   # Método funcional sem crítica   # 17
    #     self.saldo = self.saldo + valor # self.saldo += valor
    def deposito(self, valor): # Método funcional com crítica   # 18
        if valor > 0:
            self.saldo = self.saldo + valor # self.saldo += valor
        else:
            print("Erro: valor negativo.")
    def retirada(self, valor):          # Sem RN (Regra de Negócio)   # 19
        self.saldo = self.saldo - valor # self.saldo -= valor
    def retirada_rn(self, valor):       # RN obrigatória (natural dos bancos) # 20
        if valor > self.saldo:
            print('Saldo insuficiente.')
        else:
            self.saldo = self.saldo - valor # self.saldo -= valor


# O nome de classe começa com letra maiúscula e as outras letras minúsculas.
# class NomeSubclasse(NomeSuperclasse): # Sintaxe de  herança
class PessoaFisica(Conta): # Subclasse PessoaFisica herda da superclasse Conta # 5
    def __init__(self, nome, saldo=0.0, genero=''): # Valores default (padrão)
        super().__init__(nome, saldo)   # Chama o construtor da superclasse
        self.genero = genero
    def get_genero(self):               # Consulta                  # 6
        return self.genero
    def set_genero(self, novo_genero):  # Altera                    # 7
        self.genero = novo_genero


""" - As principais modalidades de PJ:
1 - MEI (Microempreendedor Individual)
2 - ME – Microempresa
3 - EPP (Empresa de Pequeno Porte)
4 - EI (Empresário Individual) 
5 - EIRELI (Empresa Individual de Responsabilidade Limitada)
6 - Sociedade Limitada – LTDA
7 - Sociedade Anônima (SA)                                  """
# O nome de classe começa com letra maiúscula e as outras letras minúsculas.
# class NomeSubclasse(NomeSuperclasse): # Sintaxe de herança
class PessoaJuridica(Conta): # Subclasse PessoaJuridica herda da superclasse # 11
    def __init__(self, nome, saldo=0.0, modalidade=''): # Default (padrão)
        super().__init__(nome, saldo) # Chama o construtor da superclasse
        self.modalidade = modalidade
    def get_modalidade(self):                  # Consulta
        return self.modalidade
    def set_modalidade(self, nova_modalidade): # Altera
        self.modalidade = nova_modalidade



