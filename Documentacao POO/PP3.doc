from conta_aula53 import PessoaFisica, PessoaJuridica
if __name__ == '__main__':                  # main + <tab> (tecla de atalho)
    pf1 = PessoaFisica('Ana', 3000.0, 'f')  # Três argumentos           # 8
    pf2 = PessoaFisica('Ailton', 7000.0)    # Dois argumentos
    pf3 = PessoaFisica('Kelly')             # Um argumento

    print('\n- Pessoa Física 1:\nNome:', pf1.get_nome()) # Método na superclasse
    print("Saldo:", pf1.get_saldo())        # Método da superclasse     # 9
    print("Gênero:", pf1.get_genero())      # Método da subclasse
    print('\n- Pessoa Física 2:\nNome:', pf2.get_nome()) # Método na superclasse
    pf2.set_nome("Paulo")                                               # 10
    print('Nome alterado:', pf2.get_nome()) # Método na superclasse

    pj1 = PessoaJuridica('Café ABC', 15000.0, 'MEI')   # Três argumentos
    pj2 = PessoaJuridica('Padaria', 35000.0)           # Dois argumentos
    pj3 = PessoaJuridica('Loja')                       # Um argumento
    print('\n- Pessoa Jurídica 1:\nNome:', pj1.get_nome()) # Método da superclasse
    print("Saldo:", pj1.get_saldo())                   # Método da superclasse
    print("Modalidade:", pj1.get_modalidade())         # Método da subclasse

    print("\n- Pessoa Física 1:\nSaldo antes:", pf1.get_saldo())
    pf1.deposito(111)                                    # Depósito
    print("Saldo depois:", pf1.get_saldo())              # Verifica alteração
    pj1.deposito(222)
    print("- Pessoa Jurídica 1:\nSaldo antes:", pj1.get_saldo())
    print("\n- Pessoa Física 1:\nSaldo antes:", pf1.get_saldo())
    pf1.retirada(100)                                   # Retirada sem RN
    print("Saldo depois retirada, pf1:", pf1.get_saldo()) # Verifica alteração
    pj1.retirada(210)
    print("Saldo depois retirada pj1:", pj1.get_saldo()) # Verifica alteração
    print("\n- Pessoa Física 1:\nSaldo antes:", pf1.get_saldo())
    pf1.retirada_rn(100)                                    # Retirada com RN
    print("Saldo depois da retirada pf1:", pf1.get_saldo()) # Verifica alteração
    pj1.retirada_rn(210)
    print("- Pessoa Jurídica 1:\nSaldo:", pj1.get_saldo()) # Verifica alteração
    pj1.retirada_rn(20000.0)                               # Retirada, msg erro
    print('Saldo: ', pj1.get_saldo())                      # Verifica alteração
